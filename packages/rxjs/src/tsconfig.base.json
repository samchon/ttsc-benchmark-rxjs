{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "../..",
    "paths": {
      "rxjs": ["./"],
      "rxjs/*": ["./*"],
      "@rxjs/observable": ["../../observable/src/index"]
    }
  },
  "include": ["./**/*.ts", "../../observable/src/**/*.ts"],
  "exclude": ["node_modules", "../dist", "../../observable/src/**/*.spec.ts"]
}
